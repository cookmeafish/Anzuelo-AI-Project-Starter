{
  "_comment": "Generated by tools/hooks/hooks.mjs sync in the starter: every check as shipped (core skills, packs with \"pack\", library skills with \"skill\"). Upgrades compare a project's entries with this copy (a 3-way merge), so local edits are kept. Do not edit.",
  "requirements": [
    {
      "tag": "plan-saved",
      "rule": "2",
      "when": {
        "playbookUsed": "plan"
      },
      "require": {
        "filesChanged": [
          "docs/plans/**"
        ]
      },
      "message": "Save the plan to docs/plans/YYYY-MM-DD-<topic>.md (plan skill) and link it in the answer, then ask the user to review it before work starts."
    },
    {
      "tag": "debug-root-cause",
      "rule": "4",
      "when": {
        "skillUsed": "debug"
      },
      "require": {
        "answerMatches": "root cause\\s*:"
      },
      "message": "Debug skill: state the root cause in the answer (\"Root cause: <what and why>\") with the evidence that shows it, found before the fix."
    },
    {
      "tag": "debug-test-added",
      "rule": "4",
      "when": {
        "skillUsed": "debug",
        "filesChanged": [
          "src/**",
          "app/**",
          "lib/**",
          "server/**",
          "packages/**",
          "**/*.mjs",
          "**/*.py",
          "**/*.ts",
          "**/*.js"
        ]
      },
      "require": {
        "filesChanged": [
          "**/*.test.*",
          "**/*.spec.*",
          "**/test/**",
          "**/tests/**",
          "**/__tests__/**",
          "**/*_test.*",
          "**/test_*.*",
          "tools/hooks/selfcheck.mjs",
          "tools/hooks/project-scenarios.mjs"
        ]
      },
      "message": "Debug skill: code changed for the fix, but no test did. Add a test that fails without the fix and passes with it, and run the suite. If the project has no test framework, write \"N/A(debug-test-added): no test framework\" and say how the fix was checked instead."
    },
    {
      "tag": "parallel-merged",
      "rule": "4",
      "when": {
        "skillUsed": "parallel-agents"
      },
      "require": {
        "answerMatches": "\\b(combined|merged|together|full (checks|suite|test))\\b"
      },
      "message": "Parallel-agents skill: run the full checks on the combined result after the last change, and say in the answer what they showed, part by part.",
      "waitsForAgents": true
    },
    {
      "tag": "research-cited",
      "rule": "4",
      "when": {
        "skillUsed": "research"
      },
      "require": {
        "answerMatches": "(?<!^[ \\t]*)\\[\\d+\\][\\s\\S]*^[ \\t]*\\**sources:?\\**[ \\t]*\\r?\\n(?:[ \\t]*[-*]?[ \\t]*\\[\\d+\\][ \\t]+(?:https?:\\/\\/\\S+|[\\w.-]+\\/\\S+)[^\\n]*(?:\\r?\\n|$))+|nothing (is )?recorded|not (in|recorded in) the project",
        "answerNotMatches": "(?<!^[ \\t]*[-*]?[ \\t]*)\\[(\\d+)\\](?![\\s\\S]*^[ \\t]*[-*]?[ \\t]*\\[\\1\\][ \\t]+(?:https?:\\/\\/|[\\w.-]+\\/))"
      },
      "message": "Research skill, answer format: end each fact with a numbered citation [1], [2], and end the answer with \"Sources:\" and one line per number, \"[n] <link or project file>\", each a source read this turn. Or say plainly that nothing is recorded in the project.",
      "waitsForAgents": true
    },
    {
      "tag": "research-ledger",
      "rule": "4",
      "when": {
        "skillUsed": "research",
        "answerMatches": "verified:\\s*\\d+\\s+claims"
      },
      "require": {
        "toolPassed": {
          "cmd": "claims\\.mjs\\s+check",
          "pass": "CLAIMS: PASS"
        }
      },
      "message": "Research skill: the answer says it is verified, so its ledger must pass: node skills/research/scripts/claims.mjs check .cache/research/<slug>.md, and fix every ERROR."
    },
    {
      "tag": "skill-finder-report",
      "rule": "2",
      "when": {
        "skillUsed": "skill-finder"
      },
      "require": {
        "answerMatches": "existing skills? checked\\s*:"
      },
      "message": "Skill-finder skill: report the search in the answer: \"Existing skills checked: <where> - <result>\"."
    },
    {
      "tag": "skill-compared",
      "rule": "2",
      "when": {
        "skillUsed": "skill-finder",
        "toolRan": "skills\\.mjs\\s+add\\b",
        "filesChanged": [
          "skills/**"
        ]
      },
      "require": {
        "toolPassed": {
          "cmd": "skills\\.mjs\\s+compare",
          "pass": "\\b0 shared run"
        }
      },
      "message": "Skill-finder skill: a third-party skill was brought in and changed. Check the wording is ours: node tools/skills.mjs compare skills/<skill> <the untouched copy> must print \"0 shared run(s)\". Rewrite every shared run it lists."
    },
    {
      "tag": "plan-checked",
      "rule": "2",
      "when": {
        "playbookUsed": "plan",
        "filesChanged": [
          "docs/plans/**"
        ]
      },
      "require": {
        "toolRan": "plan-tasks\\.mjs\\s+check"
      },
      "message": "Plan skill: run node skills/plan/scripts/plan-tasks.mjs check <plan> and fix each warning (or give its reason) before handing the plan over."
    },
    {
      "tag": "security-report",
      "rule": "4",
      "when": {
        "skillUsed": "security-review"
      },
      "require": {
        "answerMatches": "\\|\\s*(PASS|FAIL|N/?A)\\b"
      },
      "message": "Security-review skill: end with the report table: every area PASS, FAIL or N/A with its evidence, and where each open FAIL went."
    },
    {
      "tag": "security-logged",
      "rule": "15",
      "when": {
        "skillUsed": "security-review",
        "workTurn": true
      },
      "require": {
        "filesChanged": [
          "docs/security.md"
        ]
      },
      "message": "Security-review skill: log the review in the Reviews table of docs/security.md (date, scope, result, open FAILs and where they went)."
    },
    {
      "tag": "security-code",
      "rule": "15",
      "forces": "security-review",
      "waiver": "specific",
      "hint": "\\b(log ?in|sign ?in|sign ?up|log ?out|passwords?|auth|authentication|authori[sz]ation|permissions?|user roles?|admin panel|session cookies?|cookies?|access tokens?|auth tokens?|api keys?|secrets?|credentials|cors|uploads?|endpoints?|webhooks?|api routes?|sql|query builder|shell commands?|eval|deserializ\\w*|encrypt\\w*|payments?|stripe|credit cards?|personal data|pii|gdpr)\\b|\\.env\\b",
      "when": {
        "changedContentMatches": {
          "files": [
            "**/*.js",
            "**/*.mjs",
            "**/*.cjs",
            "**/*.ts",
            "**/*.tsx",
            "**/*.jsx",
            "**/*.py",
            "**/*.rb",
            "**/*.go",
            "**/*.rs",
            "**/*.java",
            "**/*.kt",
            "**/*.cs",
            "**/*.php",
            "**/*.swift",
            "**/*.vue",
            "**/*.svelte",
            "**/*.html",
            "**/*.htm",
            "**/*.sql",
            "**/*.sh",
            "**/*.ps1"
          ],
          "ignore": [
            "tools/hooks/**",
            "tools/audit.mjs",
            "tools/packs.mjs",
            "tools/skills.mjs",
            "tools/starter.mjs",
            "tools/new-project.mjs",
            "tools/recall.mjs",
            "tools/survey.mjs",
            "tools/dedupe.mjs",
            "tools/fit.mjs",
            "tools/writing-check.mjs",
            "tools/integrity-check.mjs",
            "tools/screenshot.mjs",
            "tools/trial.mjs",
            "skills/**",
            "library/**",
            "packs/**",
            ".claude/**",
            ".codex/**",
            ".githooks/**",
            "node_modules/**",
            "dist/**",
            "build/**",
            "**/*.min.js",
            "**/*.test.*",
            "**/*.spec.*",
            "**/test/**",
            "**/tests/**",
            "**/__tests__/**",
            "**/*_test.*",
            "**/test_*.*"
          ],
          "pattern": "\\b(passw(or)?d|passwd|bcrypt|argon2|scrypt|pbkdf2|jsonwebtoken|jwt\\.(sign|verify|decode)|oauth2?|openid|saml|csrf|xsrf|set-cookie|document\\.cookie|cookie-?parser|express-session|login_required|requireAuth|isAuthenticated|authenticate|authorize|hasPermission|has_permission|checkPermission|isAdmin|is_admin|rbac|api[_-]?key|secret[_-]?key|client[_-]?secret|access[_-]?token|refresh[_-]?token|private[_-]?key|Access-Control-Allow-Origin|cors|multer|multipart\\/form-data|formidable|busboy|UploadFile|req\\.files?|request\\.files|child_process|execSync|execFile|spawnSync|subprocess|os\\.system|os\\.popen|eval|vm\\.runIn\\w+|pickle\\.loads?|yaml\\.load|unserialize|ObjectInputStream|Marshal\\.load|BinaryFormatter|createCipheriv|createDecipheriv|crypto\\.subtle|hashlib|paypal|braintree|payment_?intent|card_?number|cvv|iban|ssn|social_security|date_?of_?birth|dangerouslySetInnerHTML|v-html|mark_safe)\\b|\\bshell\\s*=\\s*True\\b|\\bnew Function\\s*\\(|\\b(exec|spawn)\\s*\\(|\\.innerHTML\\s*=|type\\s*=\\s*[\"']file[\"']|stripe\\.(charges|paymentIntents|checkout|customers)|@stripe\\/|\\b(app|router|server|api)\\.(get|post|put|patch|delete|all|use|listen)\\s*\\(|@(app|router|bp|blueprint)\\.(route|get|post|put|delete)\\b|@(Get|Post|Put|Delete|Request)Mapping\\b|\\bcreateServer\\s*\\(|\\bFastAPI\\s*\\(|\\bAPIRouter\\s*\\(|\\b(execute|query|raw)\\s*\\(\\s*(f[\"']|[\"'\\x60][^\"'\\x60\\n]*(\\$\\{|[\"'\\x60]\\s*\\+))"
        }
      },
      "require": {
        "skillUsed": "security-review"
      },
      "message": "This turn wrote security-sensitive code (sign-in, passwords, tokens, secrets, permissions, sessions, cookies, CORS, uploads, endpoints, shell or eval, query building, deserializing, crypto, payments or personal data). Follow the security-review skill for what changed (its report table and the log line in docs/security.md), even though nobody asked. If the match is not security work, waive it with N/A(security-code): <the specific reason, e.g. \"the word is a CSS class name\">."
    },
    {
      "tag": "security-config",
      "rule": "15",
      "forces": "security-review",
      "waiver": "specific",
      "hint": "\\b(\\.env|environment variables?|docker\\w*|deploy\\w*|ci pipeline|github actions?|workflow file|nginx|hosting|firewall|terraform|kubernetes|k8s|firebase rules)\\b",
      "when": {
        "filesChanged": [
          ".env",
          ".env.*",
          "**/.env",
          "**/.env.*",
          ".github/workflows/**",
          ".gitlab-ci.yml",
          "**/Dockerfile",
          "**/docker-compose*.yml",
          "**/docker-compose*.yaml",
          "**/nginx*.conf",
          "vercel.json",
          "netlify.toml",
          "fly.toml",
          "**/*.tf",
          "k8s/**",
          "**/helm/**",
          "firebase.json",
          "**/firestore.rules",
          "**/storage.rules",
          "app.yaml",
          "Procfile",
          "**/.htaccess"
        ],
        "filesIgnore": [
          "**/.env.example",
          "**/.env.sample",
          "**/.env.template"
        ]
      },
      "require": {
        "skillUsed": "security-review"
      },
      "message": "This turn changed secrets, the build pipeline or deployment settings (.env, CI workflows, Docker, hosting, infrastructure). Follow the security-review skill for those areas (Secrets, Deployment, Build pipeline, Access to infrastructure), or waive it with N/A(security-config): <the specific reason>."
    },
    {
      "tag": "security-publish",
      "rule": "15",
      "forces": "security-review",
      "waiver": "specific",
      "hint": "\\b(publish|release it|go live|make it public|deploy to prod\\w*|push to production|npm publish|open.?source it)\\b",
      "when": {
        "toolRan": "\\b(npm|pnpm|yarn)\\s+publish\\b|\\bgh\\s+release\\s+create\\b|\\bgh\\s+repo\\s+(create\\b[^\\n;&|]*--public|edit\\b[^\\n;&|]*--visibility[= ]public)|\\b(vercel|netlify)\\b[^\\n;&|]*--prod\\b|\\bfirebase\\s+deploy\\b|\\bdocker\\s+push\\b|\\btwine\\s+upload\\b|\\bcargo\\s+publish\\b|\\bvsce\\s+publish\\b|\\bflyctl?\\s+deploy\\b|\\bwrangler\\s+(deploy|publish)\\b"
      },
      "require": {
        "skillUsed": "security-review"
      },
      "message": "Something was published or deployed this turn. Hard rule 15: the security-review skill runs before anything is shared, published or released. Follow it now, log it in docs/security.md, and tell the user what it found."
    },
    {
      "tag": "debug-trigger",
      "rule": "4",
      "forces": "debug",
      "when": {
        "ranFailing": "\\b(npm|pnpm|yarn)\\s+(run\\s+)?(test|build)\\b|\\bnode\\s+--test\\b|\\bpytest\\b|\\bpython3?\\s+-m\\s+(pytest|unittest)\\b|\\bjest\\b|\\bvitest\\b|\\bmocha\\b|\\bcargo\\s+(test|build)\\b|\\bgo\\s+(test|build)\\b|\\bdotnet\\s+(test|build)\\b|\\bmvn\\s+\\w*\\s*test\\b|\\bgradlew?\\s+test\\b|\\btsc\\b|selfcheck\\.mjs|\\bmake\\s+test\\b",
        "filesChanged": [
          "src/**",
          "app/**",
          "lib/**",
          "server/**",
          "packages/**",
          "**/*.js",
          "**/*.mjs",
          "**/*.cjs",
          "**/*.ts",
          "**/*.tsx",
          "**/*.jsx",
          "**/*.py",
          "**/*.rb",
          "**/*.go",
          "**/*.rs",
          "**/*.java",
          "**/*.kt",
          "**/*.cs",
          "**/*.php",
          "**/*.swift",
          "**/*.vue",
          "**/*.svelte",
          "**/*.html",
          "**/*.htm",
          "**/*.sql",
          "**/*.sh",
          "**/*.ps1"
        ],
        "filesIgnore": [
          "docs/**",
          "**/*.md"
        ]
      },
      "require": {
        "anyOf": [
          {
            "skillUsed": "debug"
          },
          {
            "playbookUsed": "bugfix"
          },
          {
            "answerMatches": "root cause\\s*:"
          }
        ]
      },
      "message": "A test or build failed this turn and code was changed after it: that is a fix, so the debug skill applies. Say what was wrong and why (\"Root cause: <what and why>\", with the evidence), found before the fix. A test written first to fail on purpose: \"Root cause: the feature did not exist yet\"."
    },
    {
      "tag": "parallel-trigger",
      "rule": "4",
      "forces": "parallel-agents",
      "waitsForAgents": true,
      "when": {
        "toolCount": {
          "name": "^(Agent|Task)$",
          "min": 2
        }
      },
      "require": {
        "anyOf": [
          {
            "skillUsed": "parallel-agents"
          },
          {
            "answerMatches": "\\b(combined|merged|together|full (checks|suite|test))\\b"
          }
        ]
      },
      "message": "Several sub-agents worked this turn: their results are only done once checked together (parallel-agents skill). Run the full checks on the combined result after the last change and say what they showed, part by part."
    },
    {
      "tag": "foundation-set",
      "rule": "4",
      "when": {
        "playbookUsed": "app-foundation"
      },
      "require": {
        "filesChanged": [
          "docs/foundation.md"
        ],
        "answerMatches": "security[\\s\\S]*(budget|performance)[\\s\\S]*(usability|friendl)"
      },
      "message": "Fill docs/foundation.md with the user (no <...> left, status: set) and list the security tests, budget script and gates you built, each with its result.",
      "pack": "app"
    },
    {
      "tag": "verification-report",
      "rule": "4",
      "codeGlobs": true,
      "when": {
        "filesChanged": [
          "src/**",
          "app/**",
          "lib/**",
          "server/**",
          "packages/**"
        ]
      },
      "require": {
        "answerMatches": "^#{1,6}\\s*verification\\b(?=[\\s\\S]*\\bautomated\\b)(?=[\\s\\S]*(real app|manual|ran the app|in the app))(?=[\\s\\S]*\\breview\\b)(?=[\\s\\S]*(budget|foundation))(?=[\\s\\S]*(still weak|not verified|known issues|nothing weak))"
      },
      "message": "Code changed: add a Verification section with Automated (commands and results), Real app (what was exercised, screenshot paths), Budgets (still within docs/foundation.md, with numbers when performance-relevant), Independent review (SHIP/FIX and the report path) and Still weak (docs/checks/qa-standards.md).",
      "pack": "app"
    },
    {
      "tag": "review-verdict",
      "rule": "4",
      "when": {
        "playbookUsed": "feature"
      },
      "require": {
        "answerMatches": "\\bSHIP\\b"
      },
      "message": "A feature needs an independent review that ends in SHIP (fix and re-review until it does). Quote the verdict and the report path.",
      "pack": "app"
    },
    {
      "tag": "spec-written",
      "rule": "4",
      "when": {
        "playbookUsed": "feature"
      },
      "require": {
        "filesChanged": [
          "docs/specs/**"
        ]
      },
      "message": "Write or update docs/specs/<feature>.md with numbered acceptance criteria and the plan, and mark each criterion PASS in the answer.",
      "pack": "app"
    },
    {
      "tag": "release-notes",
      "rule": "12",
      "when": {
        "playbookUsed": "feature"
      },
      "require": {
        "filesChanged": [
          "docs/releases/**"
        ]
      },
      "message": "Write release notes in docs/releases/ (what changed, try it fast, try it for real).",
      "pack": "app"
    },
    {
      "tag": "release-ready",
      "rule": "12",
      "when": {
        "playbookUsed": "release"
      },
      "require": {
        "filesChanged": [
          "docs/releases/**"
        ],
        "answerMatches": "no-ai-attribution: PASS|attribution[^\\n]*(pass|clean|none)"
      },
      "message": "A release needs its notes in docs/releases/ and a clean attribution scan (node tools/hooks/git-guard.mjs scan) quoted in the answer.",
      "pack": "app"
    },
    {
      "tag": "release-rollback",
      "rule": "12",
      "when": {
        "playbookUsed": "release"
      },
      "require": {
        "answerMatches": "roll ?-?back"
      },
      "message": "Release runbook: decide the rollback plan before the deploy (how to undo it, and the numbers that mean roll back now), put it in the release notes, and name it in the answer.",
      "pack": "app"
    },
    {
      "tag": "bugfix-regression-test",
      "rule": "4",
      "when": {
        "playbookUsed": "bugfix"
      },
      "require": {
        "filesChanged": [
          "**/*.test.*",
          "**/*.spec.*",
          "**/test/**",
          "**/tests/**",
          "**/__tests__/**",
          "**/*_test.*",
          "**/test_*.*"
        ]
      },
      "message": "A bugfix needs a regression test that failed before the fix and passes after it.",
      "pack": "app"
    },
    {
      "tag": "qa-incident",
      "rule": "3",
      "when": {
        "playbookUsed": "qa",
        "promptMatches": "\\b(qa|tests?|checks?|checked) (failed|missed|didn'?t catch)|\\bslipped\\b|\\bdid(n'?t)? you (test|check)|\\bqa\\b[^\\n]*\\b(wrong|broken|still|again|missing|bug)"
      },
      "require": {
        "filesChanged": [
          "docs/lessons.md"
        ],
        "answerMatches": "what slipped[\\s\\S]*(process change|new check|hardened)"
      },
      "message": "QA missed something the user found: report What slipped, Why QA missed it, Fix, and Process change, and add a line to docs/lessons.md.",
      "pack": "app"
    },
    {
      "tag": "qa-report",
      "rule": "4",
      "when": {
        "playbookUsed": "qa"
      },
      "require": {
        "answerMatches": "\\b(what slipped|findings?|rounds?)\\b"
      },
      "message": "QA runbook: report what was found. An incident gets \"What slipped\" and the rest of the incident report; a sweep lists its rounds, findings with evidence, fixes and what is left.",
      "pack": "app"
    },
    {
      "tag": "perf-numbers",
      "rule": "4",
      "when": {
        "playbookUsed": "perf"
      },
      "require": {
        "answerMatches": "before[^\\n]{0,120}\\d[\\s\\S]{0,400}after[^\\n]{0,120}\\d"
      },
      "message": "Performance work needs before and after numbers from the same tool in the answer.",
      "pack": "app"
    },
    {
      "tag": "data-backup",
      "rule": "4",
      "when": {
        "playbookUsed": "data-change"
      },
      "require": {
        "answerMatches": "backup[\\s\\S]*restore[\\s\\S]*\\d"
      },
      "message": "Name the backup, the restore test, and the record counts before and after.",
      "pack": "app"
    },
    {
      "tag": "security-checklist",
      "rule": "4",
      "when": {
        "playbookUsed": "security-review"
      },
      "require": {
        "answerMatches": "\\|[^\\n]*\\b(PASS|FAIL|N/A)\\b[^\\n]*\\|"
      },
      "message": "Give a table of every security item with PASS/FAIL/N/A and the evidence.",
      "pack": "app"
    },
    {
      "tag": "install-matrix",
      "rule": "4",
      "when": {
        "playbookUsed": "install-update"
      },
      "require": {
        "filesChanged": [
          "docs/releases/**"
        ]
      },
      "message": "Write the install/update test matrix into the release notes, each case marked tested or for the user to run.",
      "pack": "app"
    },
    {
      "tag": "version-bump",
      "rule": "12",
      "codeGlobs": true,
      "enabled": false,
      "when": {
        "filesChanged": [
          "src/**",
          "app/**",
          "lib/**",
          "server/**",
          "packages/**"
        ]
      },
      "require": {
        "filesChanged": [
          "package.json"
        ]
      },
      "message": "Behaviour changed: raise the version number (the last part for fixes, the middle part for new features). Turned on by: node tools/packs.mjs configure app --version-file <file>.",
      "pack": "app"
    },
    {
      "tag": "app-changelog",
      "rule": "12",
      "when": {
        "filesChanged": [
          "docs/specs/**",
          "docs/releases/**",
          "docs/lessons.md"
        ]
      },
      "require": {
        "filesChanged": [
          "docs/CHANGELOG.md"
        ]
      },
      "message": "Add a dated line to docs/CHANGELOG.md.",
      "pack": "app"
    },
    {
      "tag": "root-cause-stated",
      "rule": "4",
      "when": {
        "playbookUsed": "bugfix"
      },
      "require": {
        "answerMatches": "root cause\\s*:"
      },
      "message": "Bugfix: state the root cause in the answer (\"Root cause: <what and why>\"), found before the fix (debug skill), not a description of the symptom.",
      "pack": "app"
    },
    {
      "tag": "data-change-trigger",
      "rule": "4",
      "forces": "data-change",
      "hint": "\\b(migrat\\w*|schema|database change|alter table|add (a |the )?column|rename (a |the )?(column|field|table)|change (where|how) (the )?data is (saved|stored))\\b",
      "when": {
        "filesChanged": [
          "**/migrations/**",
          "**/migrate/**",
          "**/*.sql",
