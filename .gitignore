# The starter's own repository: nothing personal, nothing machine-specific, nothing generated by local test runs.

# Hook state from working on the starter (usage stats, turn records, diagnostics)
tools/hooks/state/
# Scratch: screenshots, reviews, drafts, git backup bundles
.cache/
# The local blocklist of private terms the publish-safety sweep checks (the list itself is private)
.private-terms
# Local agent settings and generated per-machine wiring
.claude/settings.local.json
.codex/
tools/starter.local.json
.starter/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
keys.json

# Backups, logs, dependencies, build and test output
*.bundle
*.orig
*.tmp
logs/
*.log
node_modules/
dist/
build/
coverage/
test-results/
playwright-report/
__pycache__/
.venv/
venv/

# OS and editor clutter (each person's own editor and vault settings)
.obsidian/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
*.swp
